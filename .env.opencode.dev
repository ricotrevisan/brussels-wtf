# Secret references only. Resolve with: op run --env-file=.env.opencode.dev -- mix phx.server
OPENCODE_API_KEY=op://Dev/Opencode/brussels-wtf
COVERAGE_PROCESSOR=opencode
COVERAGE_GENERATION_MODE=paid
