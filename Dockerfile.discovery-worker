# Isolated subscription-only runner. No repository, host configuration, credentials
# or home contents are copied into the image. Build does not call the model.
# Minimal build context:
# tar cf - Dockerfile.discovery-worker scripts/discovery_worker.py | \
#   docker build -f Dockerfile.discovery-worker -t discovery-codex:0.155.0 -
# This is not a service image: scripts/discovery_worker.py creates one container/job.
# Bridge networking allows OpenAI access but is NOT a private-network firewall.
# Operators must apply egress policy externally; no app/DB/machine credentials
# are available inside. Never add the Docker socket, host home or --privileged.
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@0.155.0 \
    && npm cache clean --force \
    && test "$(codex --version)" = "codex-cli 0.155.0"
COPY --chmod=0555 scripts/discovery_worker.py /opt/discovery_worker.py
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python3", "-B", "/opt/discovery_worker.py", "--container-exec"]
