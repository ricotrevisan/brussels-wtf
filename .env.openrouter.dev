# Secret references only. Resolve with: op run --env-file=.env.openrouter.dev -- mix phx.server
OPENROUTER_API_KEY=op://Dev/openrouter/brussels-wtf-dev
COVERAGE_PROCESSOR=openrouter
COVERAGE_GENERATION_MODE=paid
# Development-only hard monthly ceiling in USD cents. Production has no default.
COVERAGE_MONTHLY_BUDGET_CENTS=100
BACKFILL_GENERATION_ENABLED=false
